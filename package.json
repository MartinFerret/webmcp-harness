{
  "name": "webmcp-harness",
  "version": "0.0.0",
  "private": true,
  "description": "A tiny agent harness: from a browser agent that lies about success to an Angular app exposing WebMCP tools. Measured.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:app": "npm --prefix app run build",
    "api": "tsx api/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-force-exit tests/*.test.ts",
    "agent": "tsx harness/9-index.ts",
    "demo": "tsx harness/demo.ts",
    "report": "tsx harness/report.ts"
  },
  "dependencies": {
    "openai": "^7.62.0",
    "playwright": "^1.65.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
